<div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 px-6 py-12 text-center">
  <span class="mx-auto mb-3 flex h-11 w-11 items-center justify-center rounded-xl bg-white text-slate-400 shadow-sm">
    <i data-lucide="<%= icon || 'inbox' %>" class="h-5 w-5"></i>
  </span>
  <p class="text-sm font-medium text-slate-700"><%= title %></p>
  <% if (description) { %><p class="mt-1 text-sm text-slate-500"><%= description %></p><% } %>
</div>
