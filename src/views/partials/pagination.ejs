<% if (pagination && pagination.totalItems > 0) { %>
  <div class="mt-5 flex flex-col gap-3 border-t border-slate-100 pt-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-slate-500">
      Hiển thị <span class="font-semibold text-slate-700"><%= pagination.firstItem %>–<%= pagination.lastItem %></span>
      trên <span class="font-semibold text-slate-700"><%= pagination.totalItems %></span> <%= itemLabel %>
    </p>
    <% if (pagination.totalPages > 1) { %>
      <nav aria-label="Phân trang" class="flex flex-wrap items-center justify-end gap-1">
        <% if (pagination.previousUrl) { %>
          <a href="<%= pagination.previousUrl %>" rel="prev" class="inline-flex h-9 items-center gap-1 rounded-lg border border-slate-200 bg-white px-3 text-sm font-medium text-slate-600 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700">
            <span aria-hidden="true">‹</span> Trước
          </a>
        <% } else { %>
          <span aria-disabled="true" class="inline-flex h-9 items-center gap-1 rounded-lg border border-slate-100 bg-slate-50 px-3 text-sm font-medium text-slate-300">
            <span aria-hidden="true">‹</span> Trước
          </span>
        <% } %>
        <% pagination.pages.forEach((page) => { %>
          <% if (page === null) { %>
            <span aria-hidden="true" class="px-1 text-slate-400">…</span>
          <% } else if (page.number === pagination.currentPage) { %>
            <span aria-current="page" aria-label="Trang <%= page.number %>" class="inline-flex h-9 min-w-9 items-center justify-center rounded-lg border border-indigo-600 bg-indigo-600 px-2.5 text-sm font-semibold text-white shadow-sm">
              <%= page.number %>
            </span>
          <% } else { %>
            <a href="<%= page.url %>" aria-label="Trang <%= page.number %>" class="inline-flex h-9 min-w-9 items-center justify-center rounded-lg border border-slate-200 bg-white px-2.5 text-sm font-medium text-slate-600 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700">
              <%= page.number %>
            </a>
          <% } %>
        <% }) %>
        <% if (pagination.nextUrl) { %>
          <a href="<%= pagination.nextUrl %>" rel="next" class="inline-flex h-9 items-center gap-1 rounded-lg border border-slate-200 bg-white px-3 text-sm font-medium text-slate-600 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700">
            Sau <span aria-hidden="true">›</span>
          </a>
        <% } else { %>
          <span aria-disabled="true" class="inline-flex h-9 items-center gap-1 rounded-lg border border-slate-100 bg-slate-50 px-3 text-sm font-medium text-slate-300">
            Sau <span aria-hidden="true">›</span>
          </span>
        <% } %>
      </nav>
    <% } %>
  </div>
<% } %>
