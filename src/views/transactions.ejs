<%- include('partials/app-shell-start') %>
<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div>
    <h1 class="text-2xl font-bold tracking-tight text-slate-900">Sổ thu chi</h1>
    <p class="mt-1 text-sm text-slate-500">Theo dõi phiếu thu chi, công nợ và trạng thái duyệt.</p>
  </div>
  <div class="flex flex-wrap gap-2">
    <a href="<%= csvUrl %>" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">
      <i data-lucide="file-spreadsheet" class="h-4 w-4 text-emerald-600"></i>Xuất Excel (CSV)
    </a>
    <button type="button" data-modal-target="transaction-modal" data-modal-toggle="transaction-modal" data-transaction-create class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700">
      <i data-lucide="plus" class="h-4 w-4"></i>Thêm giao dịch
    </button>
  </div>
</div>

<section class="panel-card">
  <form method="get" action="/transactions" class="mb-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-[1fr_1fr_1fr_1fr_1fr_auto]">
    <div><label for="filter-type" class="form-label">Loại giao dịch</label>
      <select id="filter-type" name="type" class="form-input">
        <option value="">Tất cả</option>
        <% transactionTypes.forEach((type) => { %><option value="<%= type %>" <%= filters.type === type ? 'selected' : '' %>><%= type === 'THU' ? 'Thu' : 'Chi' %></option><% }) %>
      </select>
    </div>
    <div><label for="filter-payment" class="form-label">Trạng thái</label>
      <select id="filter-payment" name="paymentStatus" class="form-input">
        <option value="">Tất cả</option>
        <% paymentStatuses.forEach((status) => { %><option value="<%= status %>" <%= filters.paymentStatus === status ? 'selected' : '' %>><%= status %></option><% }) %>
      </select>
    </div>
    <div><label for="filter-approval" class="form-label">Duyệt phiếu</label>
      <select id="filter-approval" name="approvalStatus" class="form-input">
        <option value="">Tất cả</option>
        <% approvalStatuses.forEach((status) => { %>
          <option value="<%= status %>" <%= filters.approvalStatus === status ? 'selected' : '' %>><%= status === 'PENDING' ? 'Chờ duyệt' : status === 'APPROVED' ? 'Đã duyệt' : 'Từ chối' %></option>
        <% }) %>
      </select>
    </div>
    <div><label for="filter-from" class="form-label">Từ ngày</label><input id="filter-from" type="date" name="from" value="<%= filters.from %>" class="form-input"></div>
    <div><label for="filter-to" class="form-label">Đến ngày</label><input id="filter-to" type="date" name="to" value="<%= filters.to %>" class="form-input"></div>
    <div class="flex items-end gap-2">
      <button type="submit" class="flex-1 rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-700">Lọc</button>
      <a href="/transactions" class="rounded-lg border border-slate-200 px-3 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50">Xóa lọc</a>
    </div>
  </form>

  <% if (transactions.length === 0) { %>
    <%- include('partials/empty-state', { icon: 'arrow-left-right', title: 'Chưa có giao dịch phù hợp', description: 'Thử thay đổi bộ lọc hoặc tạo giao dịch mới.' }) %>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="data-table min-w-[1250px]">
        <thead><tr>
          <th>Loại / ngày</th><th>Diễn giải</th><th>Khách hàng</th><th>Danh mục</th><th>Số tiền</th><th>Thanh toán</th><th>Duyệt</th><th class="text-right">Thao tác</th>
        </tr></thead>
        <tbody>
          <% transactions.forEach((transaction) => { %>
            <tr>
              <td>
                <div class="flex items-center gap-2.5">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full <%= transaction.type === 'THU' ? 'bg-emerald-50 text-emerald-600' : 'bg-rose-50 text-rose-600' %>"><i data-lucide="<%= transaction.type === 'THU' ? 'arrow-down-left' : 'arrow-up-right' %>" class="h-4 w-4"></i></span>
                  <span><span class="block text-sm font-semibold <%= transaction.type === 'THU' ? 'text-emerald-700' : 'text-rose-700' %>"><%= transaction.type === 'THU' ? 'Thu' : 'Chi' %></span><span class="mt-0.5 block whitespace-nowrap text-xs text-slate-500"><%= transaction.formattedDate %></span></span>
                </div>
              </td>
              <td><span class="block max-w-[260px] truncate font-medium text-slate-800"><%= transaction.description || 'Không có diễn giải' %></span><span class="mt-0.5 block text-xs text-slate-400">Mã #<%= transaction.id %></span></td>
              <td class="text-slate-600"><%= transaction.customer_name || '—' %></td>
              <td><span class="badge badge-neutral"><%= transaction.category %></span></td>
              <td class="whitespace-nowrap font-semibold <%= transaction.amountHidden ? 'text-slate-400' : transaction.type === 'THU' ? 'text-emerald-700' : 'text-rose-700' %>"><%= transaction.amountHidden ? 'Bảo mật' : `${transaction.type === 'THU' ? '+' : '−'}${transaction.formattedAmount}` %></td>
              <td><span class="badge <%= transaction.payment_status === 'Công nợ' ? 'badge-debt' : 'badge-paid' %>"><%= transaction.payment_status %></span></td>
              <td>
                <span class="badge <%= transaction.approval_status === 'PENDING' ? 'badge-debt' : transaction.approval_status === 'REJECTED' ? 'badge-neutral' : 'badge-paid' %>">
                  <%= transaction.approval_status === 'PENDING' ? 'Chờ duyệt' : transaction.approval_status === 'REJECTED' ? 'Từ chối' : 'Đã duyệt' %>
                </span>
                <% if (transaction.approval_status === 'REJECTED' && transaction.rejection_reason) { %>
                  <span class="mt-1 block max-w-[220px] truncate text-xs text-rose-600" title="<%= transaction.rejection_reason %>"><%= transaction.rejection_reason %></span>
                <% } %>
              </td>
              <td>
                <div class="flex justify-end gap-1">
                  <button type="button" data-transaction-view="<%= transaction.detailsJson %>" data-modal-target="transaction-details-modal" data-modal-toggle="transaction-details-modal" class="icon-button" aria-label="Xem phiếu #<%= transaction.id %>" title="Xem chi tiết"><i data-lucide="eye" class="h-4 w-4"></i></button>
                  <% if (canApproveTransactions && transaction.approval_status === 'PENDING') { %>
                    <form method="post" action="/transactions/<%= transaction.id %>/approve">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="inline-flex h-9 items-center gap-1 rounded-lg px-2.5 text-xs font-semibold text-emerald-700 hover:bg-emerald-50" title="Duyệt phiếu"><i data-lucide="check" class="h-4 w-4"></i><span>Duyệt</span></button>
                    </form>
                    <form method="post" action="/transactions/<%= transaction.id %>/reject" class="flex items-center gap-1">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input name="reason" required maxlength="1000" class="w-36 rounded-md border border-slate-200 px-2 py-1.5 text-xs" placeholder="Lý do từ chối" aria-label="Lý do từ chối phiếu #<%= transaction.id %>">
                      <button type="submit" class="inline-flex h-9 items-center gap-1 rounded-lg px-2.5 text-xs font-semibold text-rose-700 hover:bg-rose-50" title="Từ chối phiếu"><i data-lucide="x" class="h-4 w-4"></i><span>Từ chối</span></button>
                    </form>
                  <% } %>
                  <% if (transaction.canEdit) { %>
                    <button type="button" data-transaction-edit="<%= transaction.detailsJson %>" data-modal-target="transaction-modal" data-modal-toggle="transaction-modal" class="icon-button" aria-label="Sửa phiếu #<%= transaction.id %>" title="Chỉnh sửa"><i data-lucide="pencil" class="h-4 w-4"></i></button>
                  <% } %>
                  <% if (canMarkTransactionsPaid && transaction.approval_status === 'APPROVED' && transaction.payment_status === 'Công nợ') { %>
                    <form method="post" action="/transactions/<%= transaction.id %>/paid">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="inline-flex h-9 items-center gap-1.5 rounded-lg px-2.5 text-xs font-semibold text-emerald-700 hover:bg-emerald-50" title="Đánh dấu đã thu/chi"><i data-lucide="check" class="h-4 w-4"></i><span>Đã thu/chi</span></button>
                    </form>
                  <% } %>
                  <% if (canDeleteTransactions) { %>
                    <form method="post" action="/transactions/<%= transaction.id %>/delete" data-confirm-delete data-confirm-message="Xóa phiếu này? Thao tác không thể hoàn tác.">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="icon-button text-slate-400 hover:bg-rose-50 hover:text-rose-600" aria-label="Xóa phiếu #<%= transaction.id %>" title="Xóa"><i data-lucide="trash-2" class="h-4 w-4"></i></button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-xs text-slate-400">Đang hiển thị <%= transactions.length %> giao dịch</p>
  <% } %>
</section>

<div id="transaction-modal" tabindex="-1" aria-hidden="true" class="fixed left-0 right-0 top-0 z-50 hidden h-[calc(100%-1rem)] max-h-full w-full items-center justify-center overflow-y-auto overflow-x-hidden p-4 md:inset-0">
  <div class="relative max-h-full w-full max-w-2xl">
    <div class="relative rounded-2xl bg-white shadow-xl">
      <div class="flex items-center justify-between border-b border-slate-100 px-6 py-4">
        <div><h3 id="transaction-modal-title" class="text-lg font-semibold text-slate-900">Thêm phiếu thu chi</h3><p class="mt-1 text-sm text-slate-500">Phiếu mới sẽ chờ admin hoặc người có quyền duyệt.</p></div>
        <button type="button" data-modal-hide="transaction-modal" class="icon-button" aria-label="Đóng"><i data-lucide="x" class="h-5 w-5"></i></button>
      </div>
      <form id="transaction-form" method="post" action="/transactions" class="space-y-4 p-6">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="grid gap-4 sm:grid-cols-2">
          <div><label for="transaction-type" class="form-label">Loại giao dịch <span class="text-rose-500">*</span></label>
            <select id="transaction-type" name="type" required class="form-input"><option value="THU">Thu</option><option value="CHI">Chi</option></select>
          </div>
          <div><label for="transaction-amount" class="form-label">Số tiền (VNĐ) <span class="text-rose-500">*</span></label>
            <input id="transaction-amount" name="amount" type="number" min="1" max="9000000000000" step="1" required class="form-input" placeholder="Ví dụ: 15000000">
          </div>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div><label for="transaction-category" class="form-label">Danh mục <span class="text-rose-500">*</span></label>
            <select id="transaction-category" name="category" required class="form-input"><% categories.forEach((category) => { %><option value="<%= category %>"><%= category %></option><% }) %></select>
          </div>
          <div><label for="transaction-date" class="form-label">Ngày giao dịch <span class="text-rose-500">*</span></label>
            <input id="transaction-date" name="transactionDate" type="date" required class="form-input">
          </div>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div><label for="transaction-payment-status" class="form-label">Trạng thái thanh toán</label>
            <select id="transaction-payment-status" name="paymentStatus" class="form-input"><% paymentStatuses.forEach((status) => { %><option value="<%= status %>"><%= status %></option><% }) %></select>
          </div>
          <div><label for="transaction-customer" class="form-label">Khách hàng liên quan</label>
            <select id="transaction-customer" name="customerId" class="form-input"><option value="">Không liên kết</option><% customers.forEach((customer) => { %><option value="<%= customer.id %>"><%= customer.name %></option><% }) %></select>
          </div>
        </div>
        <div><label for="transaction-description" class="form-label">Diễn giải</label>
          <textarea id="transaction-description" name="description" rows="3" maxlength="2000" class="form-input" placeholder="Nội dung giao dịch..."></textarea>
        </div>
        <div class="flex justify-end gap-2 border-t border-slate-100 pt-4">
          <button type="button" data-modal-hide="transaction-modal" class="rounded-lg border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50">Hủy</button>
          <button type="submit" class="rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700"><span id="transaction-submit-label">Tạo phiếu</span></button>
        </div>
      </form>
    </div>
  </div>
</div>

<div id="transaction-details-modal" tabindex="-1" aria-hidden="true" class="fixed left-0 right-0 top-0 z-50 hidden h-[calc(100%-1rem)] max-h-full w-full items-center justify-center overflow-y-auto overflow-x-hidden p-4 md:inset-0">
  <div class="relative max-h-full w-full max-w-2xl">
    <div class="relative rounded-2xl bg-white shadow-xl">
      <div class="flex items-center justify-between border-b border-slate-100 px-6 py-4">
        <div><h3 id="transaction-details-title" class="text-lg font-semibold text-slate-900">Chi tiết phiếu</h3><p class="mt-1 text-sm text-slate-500">Thông tin phiếu thu chi và lịch sử duyệt.</p></div>
        <button type="button" data-modal-hide="transaction-details-modal" class="icon-button" aria-label="Đóng"><i data-lucide="x" class="h-5 w-5"></i></button>
      </div>
      <dl class="grid gap-x-6 gap-y-4 p-6 sm:grid-cols-2">
        <div><dt class="text-xs font-medium text-slate-500">Loại phiếu</dt><dd id="transaction-details-type" class="mt-1 text-sm font-semibold text-slate-800"></dd></div>
        <div><dt class="text-xs font-medium text-slate-500">Số tiền</dt><dd id="transaction-details-amount" class="mt-1 text-sm font-semibold text-slate-800"></dd></div>
        <div><dt class="text-xs font-medium text-slate-500">Ngày giao dịch</dt><dd id="transaction-details-date" class="mt-1 text-sm text-slate-800"></dd></div>
        <div><dt class="text-xs font-medium text-slate-500">Danh mục</dt><dd id="transaction-details-category" class="mt-1 text-sm text-slate-800"></dd></div>
        <div><dt class="text-xs font-medium text-slate-500">Khách hàng</dt><dd id="transaction-details-customer" class="mt-1 text-sm text-slate-800"></dd></div>
        <div><dt class="text-xs font-medium text-slate-500">Thanh toán</dt><dd id="transaction-details-payment" class="mt-1 text-sm text-slate-800"></dd></div>
        <div><dt class="text-xs font-medium text-slate-500">Trạng thái duyệt</dt><dd id="transaction-details-approval" class="mt-1 text-sm text-slate-800"></dd></div>
        <div><dt class="text-xs font-medium text-slate-500">Người tạo</dt><dd id="transaction-details-creator" class="mt-1 text-sm text-slate-800"></dd></div>
        <div><dt class="text-xs font-medium text-slate-500">Người duyệt</dt><dd id="transaction-details-reviewer" class="mt-1 text-sm text-slate-800"></dd></div>
        <div id="transaction-details-rejection-container" class="hidden sm:col-span-2"><dt class="text-xs font-medium text-slate-500">Lý do từ chối</dt><dd id="transaction-details-rejection" class="mt-1 whitespace-pre-wrap text-sm text-rose-700"></dd></div>
        <div class="sm:col-span-2"><dt class="text-xs font-medium text-slate-500">Diễn giải</dt><dd id="transaction-details-description" class="mt-1 whitespace-pre-wrap text-sm text-slate-800"></dd></div>
      </dl>
    </div>
  </div>
</div>
<%- include('partials/app-shell-end') %>
