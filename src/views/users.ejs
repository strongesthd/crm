<%- include('partials/app-shell-start') %>
<div class="mb-7">
  <h1 class="text-2xl font-bold tracking-tight text-slate-900">Người dùng</h1>
  <p class="mt-1 text-sm text-slate-500">Tạo tài khoản, cập nhật thông tin hoặc đặt lại mật khẩu nhân viên.</p>
</div>

<section class="mb-6 panel-card">
  <div class="mb-5">
    <h2 class="text-base font-semibold text-slate-900">Tạo tài khoản nhân viên</h2>
    <p class="mt-1 text-sm text-slate-500">Mật khẩu tối thiểu 12 ký tự. Quyền duyệt có thể thay đổi sau.</p>
  </div>
  <form method="post" action="/users" class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div>
      <label for="user-full-name" class="form-label">Họ tên</label>
      <input id="user-full-name" name="fullName" required maxlength="120" class="form-input" autocomplete="name">
    </div>
    <div>
      <label for="user-username" class="form-label">Tên đăng nhập</label>
      <input id="user-username" name="username" required minlength="3" maxlength="80" pattern="[A-Za-z0-9._-]+" class="form-input" autocomplete="username">
    </div>
    <div>
      <label for="user-password" class="form-label">Mật khẩu tạm</label>
      <input id="user-password" name="password" type="password" required minlength="12" maxlength="128" class="form-input" autocomplete="new-password">
    </div>
    <div>
      <label for="user-role" class="form-label">Chức danh</label>
      <select id="user-role" name="role" required class="form-input">
        <% userRoles.forEach((role) => { %><option value="<%= role.value %>"><%= role.label %></option><% }) %>
      </select>
    </div>
    <div class="flex flex-col justify-end gap-3">
      <label class="flex items-center gap-2 text-sm text-slate-700">
        <input type="checkbox" name="canApprove" class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500">
        Có quyền duyệt phiếu
      </label>
      <button type="submit" class="rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700">Tạo tài khoản</button>
    </div>
  </form>
</section>

<section class="panel-card">
  <div class="mb-5">
    <h2 class="text-base font-semibold text-slate-900">Danh sách tài khoản</h2>
    <p class="mt-1 text-sm text-slate-500">Chọn một nhân viên để sửa thông tin hoặc quản lý quyền và trạng thái tài khoản.</p>
  </div>
  <% if (users.length === 0) { %>
    <%- include('partials/empty-state', { icon: 'users', title: 'Chưa có tài khoản', description: 'Tạo tài khoản nhân viên ở biểu mẫu phía trên.' }) %>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="data-table min-w-[800px]">
        <thead><tr><th>Nhân viên</th><th>Chức danh</th><th>Trạng thái</th><th>Quyền duyệt</th><th class="text-right">Quản lý</th></tr></thead>
        <tbody>
          <% users.forEach((user) => { %>
            <tr>
              <td>
                <button type="button" data-user-open="<%= user.detailsJson %>" data-modal-target="user-action-modal" data-modal-toggle="user-action-modal" class="group flex w-full items-center gap-3 rounded-lg py-1 text-left">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-indigo-50 text-xs font-semibold text-indigo-700"><%= getInitials(user.fullName) %></span>
                  <span class="min-w-0 flex-1">
                    <span class="block truncate font-semibold text-slate-800 group-hover:text-indigo-700"><%= user.fullName %></span>
                    <span class="mt-0.5 block truncate text-xs text-slate-500"><%= user.username %></span>
                  </span>
                </button>
              </td>
              <td><span class="badge <%= user.role === 'admin' ? 'badge-info' : 'badge-neutral' %>"><%= user.roleLabel %></span></td>
              <td><span class="badge <%= user.isActive ? 'badge-paid' : 'badge-neutral' %>"><%= user.isActive ? 'Đang hoạt động' : 'Đã khóa' %></span></td>
              <td>
                <% if (user.role === 'admin') { %>
                  <span class="text-sm font-medium text-emerald-700">Luôn được duyệt</span>
                <% } else { %>
                  <span class="text-sm text-slate-600"><%= user.canApprove ? 'Được duyệt' : 'Không có quyền' %></span>
                <% } %>
              </td>
              <td class="text-right">
                <button type="button" data-user-open="<%= user.detailsJson %>" data-modal-target="user-action-modal" data-modal-toggle="user-action-modal" class="icon-button" aria-label="Quản lý <%= user.fullName %>" title="Quản lý người dùng"><i data-lucide="ellipsis" class="h-4 w-4"></i></button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<div id="user-action-modal" tabindex="-1" aria-hidden="true" class="fixed left-0 right-0 top-0 z-50 hidden h-[calc(100%-1rem)] max-h-full w-full items-center justify-center overflow-y-auto overflow-x-hidden p-4 md:inset-0">
  <div class="relative max-h-full w-full max-w-2xl">
    <div class="relative rounded-2xl bg-white shadow-xl">
      <div class="flex items-center justify-between border-b border-slate-100 px-6 py-4">
        <div>
          <h3 id="user-action-title" class="text-lg font-semibold text-slate-900">Quản lý người dùng</h3>
          <p id="user-action-subtitle" class="mt-1 text-sm text-slate-500"></p>
        </div>
        <button type="button" data-modal-hide="user-action-modal" class="icon-button" aria-label="Đóng"><i data-lucide="x" class="h-5 w-5"></i></button>
      </div>

      <div class="max-h-[70vh] space-y-6 overflow-y-auto p-6">
        <form id="user-profile-form" method="post" action="#" class="space-y-4">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <h4 class="text-sm font-semibold text-slate-800">Thông tin đăng nhập</h4>
          <div>
            <label for="user-edit-full-name" class="form-label">Họ tên</label>
            <input id="user-edit-full-name" name="fullName" required maxlength="120" class="form-input">
          </div>
          <div>
            <label for="user-edit-username" class="form-label">Tên đăng nhập</label>
            <input id="user-edit-username" name="username" required minlength="3" maxlength="80" pattern="[A-Za-z0-9._-]+" class="form-input" autocomplete="username">
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="user-edit-password" class="form-label">Mật khẩu mới</label>
              <input id="user-edit-password" name="password" type="password" minlength="12" maxlength="128" class="form-input" autocomplete="new-password" placeholder="Để trống để giữ nguyên">
            </div>
            <div>
              <label for="user-edit-password-confirmation" class="form-label">Xác nhận mật khẩu mới</label>
              <input id="user-edit-password-confirmation" name="passwordConfirmation" type="password" minlength="12" maxlength="128" class="form-input" autocomplete="new-password">
            </div>
          </div>
          <div class="flex justify-end">
            <button type="submit" class="rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700">Lưu thông tin</button>
          </div>
        </form>

        <form id="user-role-form" method="post" action="#" class="hidden space-y-3 border-t border-slate-100 pt-5">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label for="user-edit-role" class="form-label">Chức danh</label>
          <div class="flex items-center gap-3">
            <select id="user-edit-role" name="role" required class="form-input flex-1">
              <% userRoles.forEach((role) => { %><option value="<%= role.value %>"><%= role.label %></option><% }) %>
            </select>
            <button type="submit" class="rounded-lg border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Cập nhật</button>
          </div>
        </form>

        <form id="user-approval-form" method="post" action="#" class="hidden border-t border-slate-100 pt-5">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="flex items-center justify-between gap-4">
            <span>
              <span class="block text-sm font-semibold text-slate-800">Quyền duyệt phiếu</span>
              <span class="mt-1 block text-xs text-slate-500">Cho phép nhân viên duyệt hoặc từ chối phiếu.</span>
            </span>
            <span class="flex shrink-0 items-center gap-2">
              <input id="user-edit-can-approve" type="checkbox" name="canApprove" class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500">
              <span class="text-sm text-slate-600">Được duyệt</span>
            </span>
          </label>
          <div class="mt-3 flex justify-end">
            <button type="submit" class="rounded-lg border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Lưu quyền</button>
          </div>
        </form>

        <form id="user-status-form" method="post" action="#" class="hidden border-t border-slate-100 pt-5">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <p id="user-status-description" class="mb-3 text-sm text-slate-600"></p>
          <button id="user-status-button" type="submit" class="rounded-lg border border-rose-200 px-4 py-2.5 text-sm font-semibold text-rose-700 hover:bg-rose-50"></button>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('partials/app-shell-end') %>
