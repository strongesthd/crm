<%- include('partials/app-shell-start') %>
<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div>
    <h1 class="text-2xl font-bold tracking-tight text-slate-900">Tổng quan</h1>
    <p class="mt-1 text-sm text-slate-500">Theo dõi tình hình kinh doanh và dòng tiền của bạn.</p>
  </div>
  <form method="get" action="/" class="flex items-end gap-2">
    <div>
      <label for="month" class="mb-1.5 block text-xs font-medium text-slate-500">Tháng</label>
      <select id="month" name="month" class="rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm focus:border-indigo-500 focus:ring-indigo-500">
        <% for (let month = 1; month <= 12; month += 1) { %>
          <option value="<%= month %>" <%= selectedMonth === month ? 'selected' : '' %>>Tháng <%= month %></option>
        <% } %>
      </select>
    </div>
    <div>
      <label for="year" class="mb-1.5 block text-xs font-medium text-slate-500">Năm</label>
      <select id="year" name="year" class="rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm focus:border-indigo-500 focus:ring-indigo-500">
        <% years.forEach((year) => { %><option value="<%= year %>" <%= selectedYear === year ? 'selected' : '' %>><%= year %></option><% }) %>
      </select>
    </div>
    <button type="submit" class="h-[42px] rounded-lg bg-indigo-600 px-4 text-sm font-semibold text-white hover:bg-indigo-700">Lọc</button>
  </form>
</div>

<% if (canApproveTransactions && pendingApprovalCount > 0) { %>
  <a href="/transactions?approvalStatus=PENDING" class="mb-6 flex items-center justify-between gap-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900 hover:bg-amber-100">
    <span><strong><%= pendingApprovalCount %> phiếu</strong> đang chờ bạn duyệt.</span>
    <span class="shrink-0 font-semibold">Xem phiếu <i data-lucide="arrow-right" class="inline h-4 w-4"></i></span>
  </a>
<% } %>

<section class="mb-7 grid gap-4 sm:grid-cols-2 xl:grid-cols-<%= canViewCosts ? '4' : '2' %>">
  <article class="kpi-card">
    <div class="flex items-start justify-between">
      <div>
        <p class="text-sm font-medium text-slate-500">Tổng thu đã thanh toán</p>
        <p class="mt-3 text-2xl font-bold tracking-tight text-slate-900"><%= formatCurrency(totals.income) %></p>
      </div>
      <span class="kpi-icon bg-emerald-50 text-emerald-600"><i data-lucide="trending-up" class="h-5 w-5"></i></span>
    </div>
    <p class="mt-3 text-xs text-slate-400">Trong tháng <%= selectedMonth %>/<%= selectedYear %></p>
  </article>
  <% if (canViewCosts) { %>
  <article class="kpi-card">
    <div class="flex items-start justify-between">
      <div>
        <p class="text-sm font-medium text-slate-500">Tổng chi đã thanh toán</p>
        <p class="mt-3 text-2xl font-bold tracking-tight text-slate-900"><%= formatCurrency(totals.expenses) %></p>
      </div>
      <span class="kpi-icon bg-rose-50 text-rose-600"><i data-lucide="trending-down" class="h-5 w-5"></i></span>
    </div>
    <p class="mt-3 text-xs text-slate-400">Trong tháng <%= selectedMonth %>/<%= selectedYear %></p>
  </article>
  <article class="kpi-card">
    <div class="flex items-start justify-between">
      <div>
        <p class="text-sm font-medium text-slate-500">Lợi nhuận ròng</p>
        <p class="mt-3 text-2xl font-bold tracking-tight <%= totals.profit >= 0 ? 'text-emerald-700' : 'text-rose-700' %>"><%= formatCurrency(totals.profit) %></p>
      </div>
      <span class="kpi-icon bg-indigo-50 text-indigo-600"><i data-lucide="chart-no-axes-combined" class="h-5 w-5"></i></span>
    </div>
    <p class="mt-3 text-xs text-slate-400">Tổng thu trừ tổng chi trong tháng</p>
  </article>
  <% } %>
  <article class="kpi-card">
    <div class="flex items-start justify-between">
      <div>
        <p class="text-sm font-medium text-slate-500"><%= canViewCosts ? 'Công nợ tồn đọng' : 'Công nợ khách hàng' %></p>
        <p class="mt-3 text-2xl font-bold tracking-tight text-amber-700"><%= formatCurrency(totals.outstanding) %></p>
      </div>
      <span class="kpi-icon bg-amber-50 text-amber-600"><i data-lucide="clock-3" class="h-5 w-5"></i></span>
    </div>
    <p class="mt-3 text-xs text-slate-400"><%= canViewCosts ? 'Các khoản thu và chi chưa thanh toán' : 'Các khoản thu từ khách hàng chưa thanh toán' %></p>
  </article>
</section>

<section class="mb-7 grid gap-5 xl:grid-cols-[1.6fr_1fr]">
  <article class="panel-card">
    <div class="mb-5 flex items-center justify-between">
      <div>
        <h2 class="text-base font-semibold text-slate-900"><%= canViewCosts ? 'Dòng tiền 6 tháng gần nhất' : 'Tổng thu 6 tháng gần nhất' %></h2>
        <p class="mt-1 text-xs text-slate-500">Chỉ tính giao dịch đã thanh toán</p>
      </div>
      <span class="rounded-lg bg-slate-50 px-3 py-1.5 text-xs font-medium text-slate-500">VNĐ</span>
    </div>
    <div class="chart-container">
      <canvas id="monthly-chart"
        data-labels="<%= JSON.stringify(chartData.labels) %>"
        data-income="<%= JSON.stringify(chartData.income) %>"
        data-expenses="<%= JSON.stringify(chartData.expenses) %>"
        data-can-view-costs="<%= canViewCosts %>"
        aria-label="Biểu đồ so sánh thu và chi trong sáu tháng gần nhất"></canvas>
    </div>
  </article>
  <article class="panel-card">
    <div class="mb-4 flex items-center justify-between">
      <div>
        <h2 class="text-base font-semibold text-slate-900">Giao dịch gần đây</h2>
        <p class="mt-1 text-xs text-slate-500">5 khoản thu chi mới nhất</p>
      </div>
      <a href="/transactions" class="text-sm font-semibold text-indigo-600 hover:text-indigo-700">Xem tất cả</a>
    </div>
    <% if (recentTransactions.length === 0) { %>
      <%- include('partials/empty-state', { icon: 'receipt-text', title: 'Chưa có giao dịch', description: 'Giao dịch mới sẽ xuất hiện tại đây.' }) %>
    <% } else { %>
      <div class="divide-y divide-slate-100">
        <% recentTransactions.forEach((transaction) => { %>
          <div class="flex items-center gap-3 py-3.5">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full <%= transaction.type === 'THU' ? 'bg-emerald-50 text-emerald-600' : 'bg-rose-50 text-rose-600' %>">
              <i data-lucide="<%= transaction.type === 'THU' ? 'arrow-down-left' : 'arrow-up-right' %>" class="h-4 w-4"></i>
            </span>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-medium text-slate-800"><%= transaction.description || transaction.category %></p>
              <p class="mt-0.5 truncate text-xs text-slate-500"><%= transaction.customer_name || transaction.category %> · <%= transaction.formattedDate %></p>
            </div>
            <div class="text-right">
              <p class="whitespace-nowrap text-sm font-semibold <%= transaction.amountHidden ? 'text-slate-400' : transaction.type === 'THU' ? 'text-emerald-700' : 'text-rose-700' %>"><%= transaction.amountHidden ? 'Bảo mật' : `${transaction.type === 'THU' ? '+' : '−'}${transaction.formattedAmount}` %></p>
              <span class="badge <%= transaction.payment_status === 'Công nợ' ? 'badge-debt' : 'badge-paid' %> mt-1"><%= transaction.payment_status %></span>
              <span class="badge <%= transaction.approval_status === 'PENDING' ? 'badge-debt' : transaction.approval_status === 'REJECTED' ? 'badge-neutral' : 'badge-paid' %> mt-1"><%= transaction.approval_status === 'PENDING' ? 'Chờ duyệt' : transaction.approval_status === 'REJECTED' ? 'Từ chối' : 'Đã duyệt' %></span>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </article>
</section>

<section class="flex flex-col gap-4 rounded-2xl border border-indigo-100 bg-gradient-to-r from-indigo-50 to-white p-5 sm:flex-row sm:items-center sm:justify-between">
  <div class="flex items-start gap-3">
    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white text-indigo-600 shadow-sm"><i data-lucide="sparkles" class="h-5 w-5"></i></span>
    <div>
      <h2 class="text-sm font-semibold text-slate-900">Bắt đầu quản lý công việc</h2>
      <p class="mt-1 text-sm text-slate-500">Thêm khách hàng hoặc ghi nhận giao dịch thu chi mới.</p>
    </div>
  </div>
  <div class="flex gap-2">
    <a href="/customers" class="rounded-lg border border-slate-200 bg-white px-3.5 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Khách hàng</a>
    <a href="/transactions" class="rounded-lg bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700">Sổ thu chi</a>
  </div>
</section>
<%- include('partials/app-shell-end') %>
